# ============================================================================
# SAFETY RULE: no secret material may ever be committable by default.
# The key/wallet-shaped patterns below are deny-by-default — extend them
# freely, never narrow them. Real secrets live only in the encrypted vault.
# ============================================================================

# Build output
/target
# Standalone probe crates (probes/*) have their own target dirs; their
# Cargo.lock files ARE committed (reproducible probes) — only build output
# is ignored.
probes/*/target/
# cargo-fuzz (R10/F17/A23): the target is committed, the machine-generated
# corpora and crash artifacts are not. Q9 owns the minimized-corpus
# retention policy and will commit those deliberately, under its own path.
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
fuzz/coverage/

# Devnet data (local Autonomi devnet + Anvil state; P16/P17)
devnet-data/
*.devnet/

# Wallet & key material
*.key
*.pem
wallets/
*wallet*.json
.secrets/

# Editor droppings
.idea/
.vscode/
*.swp
.DS_Store

# Claude Code: committed agents live in .claude/agents/ — do NOT ignore
# .claude/ itself; only local settings stay out.
.claude/settings.local.json
# Agent worktrees are transient checkouts, never tracked
.claude/worktrees/
